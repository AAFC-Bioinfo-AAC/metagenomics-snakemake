# -------------------------------------------------------------------
# Bowtie2 host index
# -------------------------------------------------------------------

BOWTIE_INDEX = relpath("bowtie2_index")


def host_bowtie2_index_files(prefix):
    """Return Bowtie2 host-index files, supporting .bt2 and .bt2l."""

    small_index = (
        [f"{prefix}.{i}.bt2" for i in (1, 2, 3, 4)]
        + [f"{prefix}.rev.{i}.bt2" for i in (1, 2)]
    )

    large_index = (
        [f"{prefix}.{i}.bt2l" for i in (1, 2, 3, 4)]
        + [f"{prefix}.rev.{i}.bt2l" for i in (1, 2)]
    )

    if all(os.path.exists(path) for path in large_index):
        return large_index

    if all(os.path.exists(path) for path in small_index):
        return small_index

    # If an incomplete large index is present, let Snakemake report
    # exactly which .bt2l files are missing.
    if any(os.path.exists(path) for path in large_index):
        return large_index

    return small_index


BOWTIE_INDEX_FILES = host_bowtie2_index_files(BOWTIE_INDEX)


