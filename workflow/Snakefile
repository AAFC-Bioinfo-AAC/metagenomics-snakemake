samplesheet_cfg = os.path.expanduser(
    os.path.expandvars(os.fspath(config["samplesheet"]))
)

if os.path.isabs(samplesheet_cfg):
    SAMPLESHEET_PATH = samplesheet_cfg
else:
    SAMPLESHEET_PATH = os.path.join(CONFIG_DIR, samplesheet_cfg)


def resolve_read_path(filename):
    """Resolve a FASTQ path relative to READS_DIR unless already absolute."""

    filename = os.path.expanduser(
        os.path.expandvars(os.fspath(filename))
    )

    if os.path.isabs(filename):
        return os.path.normpath(filename)

    return os.path.normpath(
        os.path.join(READS_DIR, filename)
    )


def load_samples(samplesheet):
    """Load and validate the sample sheet."""

    samples = {}

    with open(samplesheet, newline="", encoding="utf-8-sig") as csvfile:
        reader = csv.DictReader(csvfile)

        required_columns = {"sample", "fastq_1", "fastq_2"}
        fieldnames = set(reader.fieldnames or [])

        missing_columns = required_columns - fieldnames
        if missing_columns:
            raise ValueError(
                "Samplesheet is missing required column(s): "
                + ", ".join(sorted(missing_columns))
            )

        for line_number, row in enumerate(reader, start=2):
            sample = (row["sample"] or "").strip()
            fastq_1 = (row["fastq_1"] or "").strip()
            fastq_2 = (row["fastq_2"] or "").strip()

            if not sample:
                raise ValueError(
                    f"Missing sample name in samplesheet line {line_number}"
                )

            if "/" in sample or "\\" in sample:
                raise ValueError(
                    f"Invalid sample name '{sample}' in line {line_number}: "
                    "sample names cannot contain path separators"
                )

            if sample in samples:
                raise ValueError(
                    f"Duplicate sample name '{sample}' in samplesheet "
                    f"line {line_number}"
                )

            if not fastq_1 or not fastq_2:
                raise ValueError(
                    f"Sample '{sample}' is missing fastq_1 or fastq_2 "
                    f"in samplesheet line {line_number}"
                )

            samples[sample] = {
                "fastq_1": resolve_read_path(fastq_1),
                "fastq_2": resolve_read_path(fastq_2),
            }

    if not samples:
        raise ValueError(
            f"No samples were found in samplesheet: {samplesheet}"
        )

    return samples


SAMPLES = load_samples(SAMPLESHEET_PATH)
SAMPLE_NAMES = list(SAMPLES.keys())


